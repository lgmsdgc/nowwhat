# Works without a Supabase project. Switch explicitly to supabase to connect.
NEXT_PUBLIC_DATA_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: sb_secret_... (legacy service_role also supported).
# Never use this key in a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=
